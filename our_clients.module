<?php

/**
 * @file
 * Hook implementations for the Our clients module.
 */

use Drupal\Component\Gettext\PoStreamReader;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\locale\PoDatabaseWriter;

/**
 * Implements hook_help().
 */
function our_clients_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.our_clients':
      $output = '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The Our clients module provides a slider block with client images. Clicking a slide opens a modal window with the full image, the description and the client review.') . '</p>';
      $output .= '<h3>' . t('Uses') . '</h3>';
      $output .= '<dl>';
      $output .= '<dt>' . t('Managing slides') . '</dt>';
      $output .= '<dd>' . t('Add, edit, reorder and delete slides on the <a href=":slides">Our clients</a> page.', [':slides' => '/admin/structure/our-clients']) . '</dd>';
      $output .= '<dt>' . t('Settings') . '</dt>';
      $output .= '<dd>' . t('The block heading, the number of visible slides, autoplay and the "More details" button style are configured on the <a href=":settings">Settings</a> tab.', [':settings' => '/admin/structure/our-clients/settings']) . '</dd>';
      $output .= '<dt>' . t('Placing the block') . '</dt>';
      $output .= '<dd>' . t('Place the <em>Our clients slider</em> block into a region of your theme on the <a href=":blocks">Block layout</a> page.', [':blocks' => '/admin/structure/block']) . '</dd>';
      $output .= '</dl>';
      return $output;

  }
}

/**
 * Imports the bundled Russian translation once, when it makes sense.
 *
 * A module installed before the locale module (or on an English-only site)
 * never gets its translations/our_clients.ru.po imported. This runs on the
 * module admin pages: when the admin UI language is Russian and the locale
 * module is available, the bundled .po file is imported one time, so the
 * interface speaks Russian without any manual steps.
 */
function our_clients_maybe_import_russian_translation() {
  // Bump when the bundled .po file changes so existing sites re-import it.
  $po_version = '1.7.1';
  if (\Drupal::state()->get('our_clients.ru_po_imported') === $po_version) {
    return;
  }
  if (!\Drupal::moduleHandler()->moduleExists('locale')) {
    \Drupal::state()->set('our_clients.ru_po_imported', $po_version);
    return;
  }
  // Keep retrying on English pages - the admin may switch the language later.
  if (\Drupal::languageManager()->getCurrentLanguage()->getId() !== 'ru') {
    return;
  }
  try {
    $path = \Drupal::service('extension.path.resolver')->getPath('module', 'our_clients') . '/translations/our_clients.ru.po';
    if (!file_exists($path)) {
      \Drupal::state()->set('our_clients.ru_po_imported', $po_version);
      return;
    }
    $reader = new PoStreamReader();
    $reader->setLangcode('ru');
    $reader->setURI($path);
    $reader->open();
    $writer = new PoDatabaseWriter();
    $writer->setLangcode('ru');
    $writer->setOptions(['overwrite_options' => ['not_customized' => TRUE]]);
    $writer->setHeader($reader->getHeader());
    $writer->writeItems($reader, -1);
    $report = $writer->getReport();
    \Drupal::logger('our_clients')->info('Imported the bundled Russian translation: @add additions, @upd updates.', [
      '@add' => $report['additions'] ?? 0,
      '@upd' => $report['updates'] ?? 0,
    ]);
    \Drupal::service('cache_tags.invalidator')->invalidateTags(['locale']);
  }
  catch (\Throwable $e) {
    \Drupal::logger('our_clients')->warning('Failed to import the bundled Russian translation: @message', [
      '@message' => $e->getMessage(),
    ]);
  }
  \Drupal::state()->set('our_clients.ru_po_imported', $po_version);
}

/**
 * Implements hook_theme().
 */
function our_clients_theme($existing, $type, $theme, $path) {
  return [
    'our_clients_slider' => [
      'variables' => [
        'slides' => [],
        'heading' => '',
        'autoplay' => TRUE,
        'autoplay_speed' => 4000,
        'visible_desktop' => 4,
        'visible_tablet' => 2,
        'visible_mobile' => 1,
        'slider_max_width' => 1200,
        'image_height' => 390,
        'image_height_mobile' => 200,
        'name_font_size' => 24,
        'name_margin_top' => 0,
        'name_margin_bottom' => 0,
        'modal_width' => 760,
        'review_color' => '',
        'heading_font_size' => 0,
        'heading_font_size_mobile' => 0,
        'heading_margin_top' => 0,
        'heading_margin_bottom' => 0,
        'button_text_color' => '',
        'button_hover_text_color' => '',
        'button_border_color' => '',
        'button_background' => '',
        'button_hover_background' => '',
        'button_border_radius' => 0,
        'button_font_size' => 0,
        'button_font_size_mobile' => 0,
        'button_height' => 0,
        'button_height_mobile' => 0,
        'button_padding_x' => 0,
      ],
    ],
  ];
}
