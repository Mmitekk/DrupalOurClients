{#
/**
 * @file
 * Default theme implementation of the Our clients slider.
 *
 * Available variables:
 * - heading: The block heading.
 * - slides: Array of slides, each with:
 *   - title: The client name.
 *   - image_alt: The image alt text.
 *   - slider_image_url: URL of the scaled slider image.
 *   - modal_image_url: URL of the larger modal image.
 *   - description: Render array with the description.
 *   - reviews: Render array with the client reviews.
 * - accent_color: Hex accent color, empty to use the CSS default.
 * - autoplay: Whether autoplay is enabled.
 * - autoplay_speed: Autoplay interval in milliseconds.
 * - visible_desktop, visible_tablet, visible_mobile: Slides per view.
 * - slider_max_width: Maximum slider width in px (0 = unlimited).
 * - image_height, image_height_mobile: Slide image area height in px.
 * - name_font_size: Client name font size in px.
 * - modal_width: Modal window width in px.
 * - heading_font_size, heading_font_size_mobile: Heading font size in px
 *   (0 = inherit the theme's h2 style).
 * - heading_margin_top, heading_margin_bottom: Heading margins in px
 *   (0 = theme default).
 * - button_text_color, button_background, button_hover_background: Button
 *   colors (empty = module default).
 * - button_border_radius, button_font_size, button_font_size_mobile,
 *   button_height, button_height_mobile, button_padding_x: Button sizes in
 *   px (0 = module default).
 *
 * The heading is rendered as an h2. By default it is styled by the active
 * theme; the heading_* variables override individual properties.
 *
 * @ingroup themeable
 */
#}
{{ attach_library('our_clients/our_clients') }}
{% set oc_styles = [] %}
{% if accent_color %}
  {% set oc_styles = oc_styles|merge(['--oc-accent: ' ~ accent_color]) %}
{% endif %}
{% if slider_max_width > 0 %}
  {% set oc_styles = oc_styles|merge(['--oc-max-width: ' ~ slider_max_width ~ 'px']) %}
{% endif %}
{% if image_height > 0 %}
  {% set oc_styles = oc_styles|merge(['--oc-image-height: ' ~ image_height ~ 'px']) %}
{% endif %}
{% if image_height_mobile > 0 %}
  {% set oc_styles = oc_styles|merge(['--oc-image-height-mobile: ' ~ image_height_mobile ~ 'px']) %}
{% endif %}
{% if name_font_size > 0 %}
  {% set oc_styles = oc_styles|merge(['--oc-name-size: ' ~ name_font_size ~ 'px']) %}
{% endif %}
{% if heading_font_size > 0 %}
  {% set oc_styles = oc_styles|merge(['--oc-heading-font-size: ' ~ heading_font_size ~ 'px']) %}
{% endif %}
{% if heading_font_size_mobile > 0 %}
  {% set oc_styles = oc_styles|merge(['--oc-heading-font-size-mobile: ' ~ heading_font_size_mobile ~ 'px']) %}
{% endif %}
{% if heading_margin_top > 0 %}
  {% set oc_styles = oc_styles|merge(['--oc-heading-margin-top: ' ~ heading_margin_top ~ 'px']) %}
{% endif %}
{% if heading_margin_bottom > 0 %}
  {% set oc_styles = oc_styles|merge(['--oc-heading-margin-bottom: ' ~ heading_margin_bottom ~ 'px']) %}
{% endif %}
{% if button_text_color %}
  {% set oc_styles = oc_styles|merge(['--oc-more-color: ' ~ button_text_color]) %}
{% endif %}
{% if button_background %}
  {% set oc_styles = oc_styles|merge(['--oc-more-bg: ' ~ button_background]) %}
{% endif %}
{% if button_hover_background %}
  {% set oc_styles = oc_styles|merge(['--oc-more-bg-hover: ' ~ button_hover_background]) %}
{% endif %}
{% if button_border_radius > 0 %}
  {% set oc_styles = oc_styles|merge(['--oc-more-radius: ' ~ button_border_radius ~ 'px']) %}
{% endif %}
{% if button_font_size > 0 %}
  {% set oc_styles = oc_styles|merge(['--oc-more-font-size: ' ~ button_font_size ~ 'px']) %}
{% endif %}
{% if button_font_size_mobile > 0 %}
  {% set oc_styles = oc_styles|merge(['--oc-more-font-size-mobile: ' ~ button_font_size_mobile ~ 'px']) %}
{% endif %}
{% if button_height > 0 %}
  {% set oc_styles = oc_styles|merge(['--oc-more-height: ' ~ button_height ~ 'px']) %}
{% endif %}
{% if button_height_mobile > 0 %}
  {% set oc_styles = oc_styles|merge(['--oc-more-height-mobile: ' ~ button_height_mobile ~ 'px']) %}
{% endif %}
{% if button_padding_x > 0 %}
  {% set oc_styles = oc_styles|merge(['--oc-more-padding-x: ' ~ button_padding_x ~ 'px']) %}
{% endif %}
<div class="our-clients page-content page-margin-top-middle page-margin-bottom-middle page-padding-top-big page-padding-bottom-middle"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ heading|default('Our clients') }}"
  data-oc-autoplay="{{ autoplay ? '1' : '0' }}"
  data-oc-speed="{{ autoplay_speed }}"
  data-oc-visible-desktop="{{ visible_desktop }}"
  data-oc-visible-tablet="{{ visible_tablet }}"
  data-oc-visible-mobile="{{ visible_mobile }}"
  data-oc-modal-width="{{ modal_width }}"
  {% if oc_styles %}style="{{ oc_styles|join('; ') }};"{% endif %}
>

  {% if heading %}
    <div class="our-clients__header">
      <h2 class="our-clients__heading">{{ heading }}</h2>
    </div>
  {% endif %}

  <div class="our-clients__frame">
    <button type="button" class="our-clients__arrow our-clients__arrow--prev" data-oc-prev aria-label="{{ 'Previous slides'|t }}">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <div class="our-clients__viewport" data-oc-viewport>
      <ul class="our-clients__track" data-oc-track>
        {% for slide in slides %}
          <li class="our-clients__slide" role="group" aria-roledescription="slide" aria-label="{{ loop.index }} / {{ loop.length }}">
            <button type="button" class="our-clients__trigger" aria-haspopup="dialog">
              <span class="our-clients__figure">
                <img src="{{ slide.slider_image_url }}" alt="{{ slide.image_alt }}" loading="lazy">
              </span>
              {% if slide.title %}
                <span class="our-clients__name">{{ slide.title }}</span>
              {% endif %}
              <span class="our-clients__more">{{ 'More details'|t }}</span>
            </button>

            <div class="our-clients__modal-source" data-oc-modal-source hidden>
              {% if slide.is_video and slide.modal_media %}
                <div class="oc-modal__media oc-modal__media--video">{{ slide.modal_media }}</div>
              {% else %}
                <div class="oc-modal__image">
                  <img src="{{ slide.modal_image_url }}" alt="{{ slide.image_alt }}">
                </div>
              {% endif %}
              <div class="oc-modal__body">
                {% if slide.title %}
                  <h3 class="oc-modal__title">{{ slide.title }}</h3>
                {% endif %}
                {% if slide.description %}
                  <div class="oc-modal__description">{{ slide.description }}</div>
                {% endif %}
                {% if slide.reviews %}
                  <div class="oc-modal__reviews">
                    {% for review in slide.reviews %}
                      <figure class="oc-modal__review">
                        <div class="oc-modal__review-head">
                          <span class="oc-modal__review-stars" aria-hidden="true">{{ review.stars }}</span>
                          <span class="oc-modal__review-score">{{ review.rating }}/5</span>
                        </div>
                        <blockquote class="oc-modal__review-text">{{ review.text }}</blockquote>
                        <figcaption class="oc-modal__review-meta">
                          {% if review.author %}
                            <span class="oc-modal__review-author">{{ review.author }}</span>
                          {% endif %}
                          {% if review.city %}
                            <span class="oc-modal__review-city">{{ review.city }}</span>
                          {% endif %}
                          {% if review.date %}
                            <span class="oc-modal__review-date">{{ review.date }}</span>
                          {% endif %}
                        </figcaption>
                      </figure>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </div>
          </li>
        {% endfor %}
      </ul>
    </div>

    <button type="button" class="our-clients__arrow our-clients__arrow--next" data-oc-next aria-label="{{ 'Next slides'|t }}">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
</div>
